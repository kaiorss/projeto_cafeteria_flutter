# Servidor
PORT=3000

# PostgreSQL local
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=coloque_a_senha_do_postgres_aqui
PGDATABASE=cafeteria_db

# Render/produção: tem prioridade sobre as variáveis PG* acima.
# No Render, use a Internal Database URL para evitar tráfego externo.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Habilite somente se o provedor exigir TLS (ex.: URL externa do Render).
# PGSSL=true
